# Configuración del frontend (Vite). Copiar a `.env` y ajustar según el entorno.
# Vite solo expone al bundle las variables con prefijo VITE_.

# URL base del backend. Si se omite, el cliente usa http://127.0.0.1:8010 (ver src/services/api.js).
# Desarrollo local: http://127.0.0.1:8010
# Producción: la URL pública del backend (ej. https://api.tu-dominio.com)
VITE_API_BASE=http://127.0.0.1:8010
