# Configuración del backend — Empleado Digital.
# Copiar a `.env` y ajustar. Valores de ejemplo: NUNCA claves reales en el repo.
# Referencia completa de cada variable: backend/app/config.py.

# ── Núcleo ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here

# Modelos de OpenAI
OPENAI_MODEL=gpt-4o                    # modelo principal (respuestas)
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini    # clasificación de intención (económico)
OPENAI_MODEL_FAST=gpt-4o-mini          # tareas auxiliares rápidas
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_RETRIES=3

# Base de datos: SQLite local por defecto; en Render, PostgreSQL.
DATABASE_URL=sqlite:///./hotel.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/nombre_db

# Metadata neutra del servicio (docs de FastAPI, /info, logs de arranque).
# APP_NAME=Empleado Digital API
# APP_DESCRIPTION=API del Empleado Digital (RAG + agente)

# Ruteo del agente (arquitectura OpenAI Agents SDK). Default true, no tocar.
# USE_AGENTS_SDK_TRIAGE=true

# ── Seguridad ────────────────────────────────────────────────────────────────
# Secreto para firmar los JWT del backoffice. OBLIGATORIO un valor real (largo y
# aleatorio) en producción: con el default la app NO arranca si DEBUG=false.
JWT_SECRET=change-me-use-a-long-random-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=720

# Clave para acciones críticas del backoffice (topes de gasto, cotización, reset).
# Vacía = sin bloqueo (solo dev local); en producción setearla (header X-Admin-Key).
ADMIN_KEY=

# Bootstrap del primer admin (solo se usan si la tabla admin_users está vacía).
# BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
# BOOTSTRAP_ADMIN_PASSWORD=una-clave-fuerte

# CORS: orígenes permitidos separados por coma (sin regex en producción).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting del endpoint del agente
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=300
MAX_FILE_SIZE_MB=10

# Circuit breaker de OpenAI
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# ── Canales (opcionales — sin credenciales el webhook queda inactivo) ────────
# WhatsApp vía Twilio. En producción sin TWILIO_AUTH_TOKEN el webhook rechaza todo (403).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_MAX_ROOM_CARDS=3

# Instagram (Meta Messaging API). En producción sin INSTAGRAM_APP_SECRET el webhook
# rechaza todo (403). Ver INSTAGRAM_SETUP.md.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# ChromaDB (RAG). En Render: /data/chroma_db (disco persistente).
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=hotel_documents

# Imágenes del repositorio de conocimiento. En Render: /data/uploads_img.
MEDIA_DIR=./uploads_img

# Auditoría de turnos del chat (JSONL con PII — NUNCA dentro del paquete, gitignoreado).
# En Render: /data/audit. AUDIT_CHAT: vacío = solo en DEBUG; true/false fuerza el estado.
AUDIT_LOG_DIR=./audit_logs
# AUDIT_CHAT=

# ── Deploy / servidor ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
BASE_URL=http://localhost:8000        # URL base del backend
LANDING_URL=http://localhost:5174     # URL del sitio público (links del agente)

# URL pública del backend (solo si validar firmas de webhook detrás de un proxy
# no funciona con los headers X-Forwarded-*). Normalmente vacía.
PUBLIC_BASE_URL=

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=8

# Perfil del agente (rutas locales)
AGENT_PROFILE_PATH=./data/agent_profiles/hotel.json
# LEGACY (geografía de turismo, retirada en Fase 0.2): aún existe en config.py
# por compat de entornos viejos; sin uso real. No hace falta setearla.
# GEOGRAPHY_DATA_PATH=./data/geography.json

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | text

# Observabilidad opcional: tracing OTLP (no-op si está vacía).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
